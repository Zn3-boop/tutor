# Copy to .env and fill in real values.
# Never commit .env — it holds API keys. Most keys below are OPTIONAL:
# the app runs fully offline (local embeddings / rule-based fallbacks) without them.

# ── LLM (required for grounded chat + RAGAS judging) ──
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# ── RAG ──
# RAG_STORE_DIR=          # leave commented to use default
RAG_EMBEDDING_MODEL_PATH=all-MiniLM-L6-v2
RAG_AUTO_BUILD_FAISS=true
RAG_CHUNK_TTL_DAYS=365

# RAG Rerank (cross-encoder, offline local model)
RAG_RERANK_ENABLED=false
# RAG_RERANK_MODEL_PATH=./models/bge-reranker-base

# ── VLM (optional — requires GPU for local inference) ──
VLM_ENABLED=false
# VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# VLM_DEVICE=cpu

# VLM Cloud fallback (uses LLM_API_KEY/LLM_BASE_URL by default)
# VLM_CLOUD_MODEL=glm-4v-flash

# ── OCR (optional) ──
OCR_ENGINE=auto
OCR_LANG=ch

# ── Langfuse tracing (optional) ──
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── RAGAS evaluation (optional local embedding override) ──
# RAGAS_EMBED_MODEL=all-MiniLM-L6-v2
# RAGAS_EMBED_DEVICE=cpu

# ── Voice (Edge TTS, optional) ──
TTS_VOICE=zh-CN-XiaoxiaoNeural